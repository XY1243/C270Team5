
<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="dashboard-container">
        <div class="dashboard-header">
            <h1><%= title %></h1>
            <div class="user-info">
                <span>Welcome, <strong><%= user %></strong></span>
                <span class="badge"><%= role %></span>
                <a href="/" class="logout-btn">Logout</a>
            </div>
        </div>
        
        <div class="dashboard-nav">
            <a href="/user/dashboard" class="active">Dashboard</a>
            <a href="/user/events">Browse Events</a>
            <a href="/user/map">Map</a>
        </div>
        
        <div class="dashboard-content">
            <div class="hero-panel">
                <div>
                    <p class="hero-eyebrow">Your events</p>
                    <h2>Stay on top of upcoming activities</h2>
                    <p>Browse the latest events and find something that fits your schedule.</p>
                </div>
            </div>

            <h3 class="section-title">Upcoming Events</h3>
            <% if (events && events.length > 0) { %>
                <div class="card-grid">
                    <% events.forEach(event => { %>
                        <div class="card">
                            <div class="card-top-row">
                                <h3><%= event.title %></h3>
                                <span class="badge">Open</span>
                            </div>
                            <p><%= event.description ? event.description.substring(0, 100) : 'No description' %></p>
                            <p><strong>Organiser:</strong> <%= event.organiser_name %></p>
                            <p><strong>Date:</strong> <%= new Date(event.starts_at).toLocaleDateString() %></p>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p>No upcoming events found.</p>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>