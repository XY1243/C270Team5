
<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="dashboard-container">
        <div class="dashboard-header">
            <h1><%= title %></h1>
            <div class="user-info">
                <span>Welcome, <strong><%= user %></strong></span>
                <span class="badge"><%= role %></span>
                <a href="/" class="logout-btn">Logout</a>
            </div>
        </div>
        
        <div class="dashboard-nav">
            <a href="/admin/dashboard" class="active">Dashboard</a>
            <a href="/admin/users">Manage Users</a>
            <a href="/admin/events">Manage Events</a>
        </div>
        
        <div class="dashboard-content">
            <div class="hero-panel">
                <div>
                    <p class="hero-eyebrow">Administration</p>
                    <h2>Monitor platform activity at a glance</h2>
                    <p>Review users, events, and pending approvals from a single control panel.</p>
                </div>
            </div>

            <div class="summary-row">
                <div class="summary-card">
                    <span class="summary-label">Total Users</span>
                    <strong><%= stats.users %></strong>
                </div>
                <div class="summary-card">
                    <span class="summary-label">Total Events</span>
                    <strong><%= stats.events %></strong>
                </div>
                <div class="summary-card">
                    <span class="summary-label">Pending Events</span>
                    <strong><%= stats.pending %></strong>
                </div>
            </div>
            
            <h3 class="section-title">Recent Users</h3>
            <% if (recentUsers && recentUsers.length > 0) { %>
                <div class="card-grid">
                    <% recentUsers.forEach(user => { %>
                        <div class="card">
                            <div class="card-top-row">
                                <h3><%= user.name %></h3>
                                <span class="badge"><%= user.role %></span>
                            </div>
                            <p><%= user.email %></p>
                            <p><strong>Status:</strong> <span class="badge"><%= user.status %></span></p>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p>No users found.</p>
                </div>
            <% } %>
            
            <h3 class="section-title">Recent Events</h3>
            <% if (recentEvents && recentEvents.length > 0) { %>
                <div class="card-grid">
                    <% recentEvents.forEach(event => { %>
                        <div class="card">
                            <div class="card-top-row">
                                <h3><%= event.title %></h3>
                                <span class="badge"><%= event.status %></span>
                            </div>
                            <p><strong>Organiser:</strong> <%= event.organiser_name %></p>
                            <p><strong>Date:</strong> <%= new Date(event.starts_at).toLocaleDateString() %></p>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p>No events found.</p>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>